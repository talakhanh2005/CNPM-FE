# Mock local uses this relative API path by default.
# For the real backend locally, use http://localhost:8000 and set mocks=false.
VITE_API_URL=/api
# Optional when WebSocket is served from a different host. If omitted, the
# frontend derives ws:// or wss:// from VITE_API_URL/current origin.
VITE_WS_URL=
# Development defaults to mock enabled; production defaults to disabled.
# Set explicitly only when an environment needs to override that behavior.
VITE_ENABLE_MOCKS=

# Real backend local example:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
# VITE_ENABLE_MOCKS=false

# Local/staging fallback used when the backend ICE endpoint is unavailable or empty.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
