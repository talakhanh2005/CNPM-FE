# Local development uses MSW and this relative API path by default.
VITE_API_URL=/api
# Development defaults to mock enabled; production defaults to disabled.
# Set explicitly only when an environment needs to override that behavior.
VITE_ENABLE_MOCKS=

# Local/staging fallback used when the backend ICE endpoint is unavailable or empty.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
